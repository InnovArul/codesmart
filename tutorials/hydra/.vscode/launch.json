    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "simple_app.py",
            "args": [
                "+input=input.txt",
                "+output=output.txt"
            ],
            "console": "integratedTerminal"
        }
    ]
}